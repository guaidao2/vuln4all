# 复制成 vuln4all.ini 就生效。放在靶场根目录（和 main.py 同级）。
#
# 优先级：命令行参数 > 这个文件 > 内置默认值。
# 也就是说 `python3 main.py --port 9000` 会盖掉这里的 port。

[vuln4all]

# 绑定地址。
#   127.0.0.1  只允许本机访问（默认，最安全）
#   0.0.0.0    所有网卡都能连 —— 局域网一起打靶场就填这个
host = 127.0.0.1

# 监听端口。
port = 8800

# 绑非本机地址时的确认开关。等于"我知道别人能连进来这些漏洞"。
# 在命令行上显式写 --host 0.0.0.0 时，还额外要求 --lan。
# 填 true 就相当于确认过了。
allow_remote = false

# 改了 modules/ 下的文件自动重启（开发时方便，多人玩的时候别开）。
reload = false
